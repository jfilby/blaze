{
  "name": "blaze",
  "version": "0.1.0",
  "description": "AI native compiler: source -> contracts -> semantic IR, reviewed by a model -> targets -> native executable",
  "type": "module",
  "private": true,
  "bin": {
    "blaze": "cli.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "aic": "node cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-reporter=./test/reporter.ts test/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.65",
    "@ai-sdk/google": "^4.0.82",
    "@ai-sdk/openai": "^4.0.78",
    "@ai-sdk/openai-compatible": "^3.0.57",
    "@ai-sdk/provider": "^4.0.18",
    "ai": "^7.0.116",
    "smol-toml": "^1.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
